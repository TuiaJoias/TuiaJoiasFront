# URL base da API NestJS (projeto TuiaJoiasApi), sem barra no final.
# Obrigatória: o build falha com mensagem clara se estiver vazia.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Limite por foto para a validação imediata no navegador (MB).
# Opcional, padrão 25. Deve ser igual ao MAX_FILE_SIZE_MB do backend,
# que continua sendo a validação obrigatória.
NEXT_PUBLIC_MAX_FILE_SIZE_MB=25

# Atenção: tudo que começa com NEXT_PUBLIC_ vai para o navegador.
# Nunca coloque aqui segredos como SUPABASE_SERVICE_ROLE_KEY ou JWT_SECRET.
